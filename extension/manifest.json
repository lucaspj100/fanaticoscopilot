{
  "manifest_version": 3,
  "name": "United Copilot",
  "version": "0.1.0",
  "description": "Copiloto comercial em tempo real para calls de vendas no Zoom Web.",
  "permissions": [
    "tabCapture",
    "offscreen",
    "sidePanel",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://fanaticoscopilot.lovable.app/*",
    "http://localhost:8080/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Abrir United Copilot"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "128": "icon.png"
  }
}